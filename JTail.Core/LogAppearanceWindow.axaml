<Window x:Class="JTail.LogAppearanceWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Appearance"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <StyleInclude Source="avares://JTail.Core/Themes/Controls.axaml" />
        <Style Selector="Grid.settingsRows > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
            <DockPanel>
                <Button Name="ResetButton" Content="Reset to Default" Click="OnResetClick"
                        ToolTip.Tip="Theme colors and the default font size" />
                <StackPanel Classes="buttons">
                    <Button Name="CloseButton" Content="Close" Classes="accent" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="20" Spacing="20">
            <!-- Live preview of the log pane -->
            <Border Name="PreviewBorder" CornerRadius="6" BorderThickness="1" Padding="12,10"
                    BorderBrush="{DynamicResource JBorderBrush}">
                <TextBlock Name="PreviewText" FontFamily="{DynamicResource JMonoFont}"
                           Text="12:00:01 INFO  Server started on port 8080&#10;12:00:02 WARN  Cache miss for /api/users&#10;12:00:03 INFO  Request completed in 42 ms" />
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Classes="sectionHeader" Text="Colors" />
                <Grid Classes="settingsRows" ColumnDefinitions="100,*" RowDefinitions="Auto,10,Auto,10,Auto">
                    <TextBlock Grid.Row="0" Text="Background" />
                    <ColorPicker Grid.Row="0" Grid.Column="1" Name="BackgroundPicker" HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="2" Text="Text" />
                    <ColorPicker Grid.Row="2" Grid.Column="1" Name="TextPicker" HorizontalAlignment="Left" />
                    <TextBlock Grid.Row="4" Text="Presets" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Theme" Click="OnThemePresetClick" ToolTip.Tip="Follow the app's dark or light theme" />
                        <Button Content="Matrix" Click="OnMatrixPresetClick" ToolTip.Tip="Green text on black" />
                    </StackPanel>
                </Grid>
                <Border Name="ContrastWarning" Classes="banner" IsVisible="False">
                    <TextBlock Classes="warning" TextWrapping="Wrap"
                               Text="Low contrast: background and text are hard to tell apart." />
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Classes="sectionHeader" Text="Font" />
                <Grid Classes="settingsRows" ColumnDefinitions="100,*">
                    <TextBlock Text="Size" />
                    <NumericUpDown Grid.Column="1" Name="FontSizeUpDown"
                                   Minimum="8" Maximum="32" Increment="1" FormatString="0"
                                   Width="120" HorizontalAlignment="Left" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
