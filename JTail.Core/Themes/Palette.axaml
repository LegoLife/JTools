<!--
    Colors for every screen, in a dark ("Matrix" green-on-black) and a light variant.
    Include in App.axaml; the app's RequestedThemeVariant picks which set is used.
    Reference with {DynamicResource ...} so colors update when the theme switches.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="JBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="JSurfaceBrush" Color="#001A00" />
            <SolidColorBrush x:Key="JSurfacePressedBrush" Color="#002600" />
            <SolidColorBrush x:Key="JBorderBrush" Color="#0C4B1E" />
            <SolidColorBrush x:Key="JTextBrush" Color="#33FF66" />
            <SolidColorBrush x:Key="JTextDimBrush" Color="#1D6E32" />
            <SolidColorBrush x:Key="JAccentBrush" Color="#33FF66" />
            <SolidColorBrush x:Key="JSelectionBrush" Color="#003311" />
            <SolidColorBrush x:Key="JSelectionHoverBrush" Color="#004416" />
            <SolidColorBrush x:Key="JInputBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="JInputHoverBrush" Color="#000A00" />
            <SolidColorBrush x:Key="JWarningBackgroundBrush" Color="#1A1400" />
            <SolidColorBrush x:Key="JWarningBorderBrush" Color="#665200" />
            <SolidColorBrush x:Key="JWarningTextBrush" Color="#FFCC00" />
            <Color x:Key="JLogBackgroundColor">#000000</Color>
            <Color x:Key="JLogTextColor">#33FF66</Color>
            <SolidColorBrush x:Key="JLogBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="JLogTextBrush" Color="#33FF66" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="JBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JSurfaceBrush" Color="#EAF6EE" />
            <SolidColorBrush x:Key="JSurfacePressedBrush" Color="#D8EEDF" />
            <SolidColorBrush x:Key="JBorderBrush" Color="#B5D8C0" />
            <SolidColorBrush x:Key="JTextBrush" Color="#0B6B2A" />
            <SolidColorBrush x:Key="JTextDimBrush" Color="#5B7F66" />
            <SolidColorBrush x:Key="JAccentBrush" Color="#0B8A33" />
            <SolidColorBrush x:Key="JSelectionBrush" Color="#D3EEDB" />
            <SolidColorBrush x:Key="JSelectionHoverBrush" Color="#C3E6CD" />
            <SolidColorBrush x:Key="JInputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JInputHoverBrush" Color="#F3FAF5" />
            <SolidColorBrush x:Key="JWarningBackgroundBrush" Color="#FFF7DB" />
            <SolidColorBrush x:Key="JWarningBorderBrush" Color="#E6C65C" />
            <SolidColorBrush x:Key="JWarningTextBrush" Color="#7A5A00" />
            <Color x:Key="JLogBackgroundColor">#FFFFFF</Color>
            <Color x:Key="JLogTextColor">#14532D</Color>
            <SolidColorBrush x:Key="JLogBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="JLogTextBrush" Color="#14532D" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Accent used by Fluent controls (checkboxes, toggles, focus rings, accent buttons). Fluent ignores
         an accent defined per theme above, so ThemeAccent swaps the base color at runtime instead:
         neon green on black, a deeper green that's readable on white. -->
    <Color x:Key="SystemAccentColor">#00FF41</Color>
    <Color x:Key="SystemAccentColorDark1">#0B9E3A</Color>
    <Color x:Key="SystemAccentColorDark2">#0B8A33</Color>
    <Color x:Key="SystemAccentColorDark3">#086B27</Color>
    <Color x:Key="SystemAccentColorLight1">#33FF66</Color>
    <Color x:Key="SystemAccentColorLight2">#66FF8C</Color>
    <Color x:Key="SystemAccentColorLight3">#99FFB3</Color>
</ResourceDictionary>
