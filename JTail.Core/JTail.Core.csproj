<Project Sdk="Microsoft.NET.Sdk">

    <!-- JTail's log-tailing UI as a reusable control (JTailView), hosted by JTail.exe and by other apps. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>JTail</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.2.1" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.2.1" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.2.0" />
    </ItemGroup>

</Project>
