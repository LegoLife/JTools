<Window x:Class="JTail.FontSettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Font"
        Width="260"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource JBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Font Size" Foreground="{DynamicResource JTextBrush}" />
            <NumericUpDown Name="FontSizeUpDown"
                            Minimum="8"
                            Maximum="32"
                            Increment="1"
                            FormatString="0"
                            HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="ResetButton" Content="Reset to Default" Click="OnResetClick" />
            <Button Name="CloseButton" Content="Close" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>
