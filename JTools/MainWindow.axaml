<Window x:Class="JTools.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jtail="clr-namespace:JTail;assembly=JTail.Core"
        xmlns:local="clr-namespace:JTools"
        Title="JTools"
        Width="1100" Height="700"
        MinWidth="720" MinHeight="440"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource JBackgroundBrush}">
    <Window.Styles>
        <!-- Side bar buttons: dim until hovered; the selected tool gets a filled background and an accent pill. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource JTextDimBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="Padding" Value="0,11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource JSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource JTextBrush}" />
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource JSurfacePressedBrush}" />
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Background" Value="{DynamicResource JSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource JTextBrush}" />
        </Style>
        <Style Selector="Button.nav.selected TextBlock.icon">
            <Setter Property="Foreground" Value="{DynamicResource JAccentBrush}" />
        </Style>
        <Style Selector="Button.nav Border.indicator">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource JAccentBrush}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.nav.selected Border.indicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.nav > StackPanel">
            <Setter Property="Spacing" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav TextBlock.icon">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav TextBlock.label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <Grid ColumnDefinitions="84,*">
        <Border Grid.Column="0" Background="{DynamicResource JChromeBrush}"
                BorderBrush="{DynamicResource JBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,6">
                <Button DockPanel.Dock="Bottom" Name="ThemeButton" Classes="nav" ToolTip.Tip="Dark or light theme">
                    <Button.Flyout>
                        <MenuFlyout Placement="RightEdgeAlignedBottom">
                            <MenuItem Name="DarkThemeItem" Header="Dark" ToggleType="Radio" GroupName="Theme" Click="OnThemeItemClick" />
                            <MenuItem Name="LightThemeItem" Header="Light" ToggleType="Radio" GroupName="Theme" Click="OnThemeItemClick" />
                            <MenuItem Name="SystemThemeItem" Header="Use Windows setting" ToggleType="Radio" GroupName="Theme" Click="OnThemeItemClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel>
                        <TextBlock Classes="icon" Text="&#xE706;" />
                        <TextBlock Classes="label" Text="Theme" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <Button Name="TailNavButton" Classes="nav" Click="OnTailNavClick" ToolTip.Tip="JTail: tail log files">
                        <Panel>
                            <Border Classes="indicator" />
                            <StackPanel>
                                <TextBlock Classes="icon" Text="&#xE8A5;" />
                                <TextBlock Classes="label" Text="Tail" />
                            </StackPanel>
                        </Panel>
                    </Button>
                    <Button Name="ExpanderNavButton" Classes="nav" Click="OnExpanderNavClick" ToolTip.Tip="Text Expander: abbreviations">
                        <Panel>
                            <Border Classes="indicator" />
                            <StackPanel>
                                <TextBlock Classes="icon" Text="&#xE765;" />
                                <TextBlock Classes="label" Text="Expand" />
                            </StackPanel>
                        </Panel>
                    </Button>
                    <Button Name="RegexNavButton" Classes="nav" Click="OnRegexNavClick" ToolTip.Tip="Regex Tester: try patterns on sample text">
                        <Panel>
                            <Border Classes="indicator" />
                            <StackPanel>
                                <TextBlock Classes="icon" Text="&#xE773;" />
                                <TextBlock Classes="label" Text="Regex" />
                            </StackPanel>
                        </Panel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Panel Grid.Column="1">
            <jtail:JTailView Name="TailView" />
            <local:TextExpanderView Name="ExpanderView" IsVisible="False" />
            <local:RegexTesterView Name="RegexView" IsVisible="False" />
        </Panel>
    </Grid>
</Window>
