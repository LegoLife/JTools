<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>JTools</AssemblyName>
        <RootNamespace>JTools</RootNamespace>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <Version>0.5.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\icon.ico" />
    </ItemGroup>

    <!-- Only apply single-file / self-contained / trimming when publishing (not when debugging).
         Trimming drops the unused parts of .NET and Avalonia, and compression shrinks what's left.
         ReadyToRun is off: it roughly doubles every assembly's size for a slightly faster cold start. -->
    <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishTrimmed>true</PublishTrimmed>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.22" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.22" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\JTail.Core\JTail.Core.csproj" />
        <ProjectReference Include="..\TextExpander.Core\TextExpander.Core.csproj" />
    </ItemGroup>

</Project>
