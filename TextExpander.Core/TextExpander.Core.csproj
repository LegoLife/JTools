<Project Sdk="Microsoft.NET.Sdk">

  <!-- The text-expansion engine (keyboard hook, paste, storage, settings), shared by every app that hosts it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TextExpander</RootNamespace>
  </PropertyGroup>

</Project>
